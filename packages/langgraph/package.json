{
  "name": "@harpua/langgraph",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Idiomatic NestJS integration for LangGraph: nodes as providers, typed edge lists, checkpointers, streaming, interrupts, and OpenTelemetry tracing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcculusC/harpua.git",
    "directory": "packages/langgraph"
  },
  "homepage": "https://github.com/IcculusC/harpua/tree/main/packages/langgraph#readme",
  "bugs": {
    "url": "https://github.com/IcculusC/harpua/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "harpua-skills": "dist/cli/harpua-skills.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@langchain/langgraph-checkpoint-mongodb": "^1",
    "@langchain/langgraph-checkpoint-postgres": "^1",
    "@langchain/langgraph-checkpoint-redis": "^1",
    "@langchain/langgraph-checkpoint-sqlite": "^1",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@opentelemetry/api": "^1",
    "zod": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-mongodb": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-postgres": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-redis": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@harpua/eslint-config": "workspace:*",
    "@harpua/typescript-config": "workspace:*",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.4.7",
    "@langchain/langgraph-checkpoint-mongodb": "^1.4.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/langgraph-checkpoint-redis": "^1.0.10",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/testing": "12.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@swc/core": "1.16.2",
    "@types/node": "22.15.30",
    "eslint": "9.39.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2",
    "zod": "3.25.76"
  }
}
