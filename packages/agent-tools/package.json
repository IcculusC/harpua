{
  "name": "@harpua/agent-tools",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Framework-agnostic prebuilt LangChain tools for agents (works with any LangChain/LangGraph app)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcculusC/harpua.git",
    "directory": "packages/agent-tools"
  },
  "homepage": "https://github.com/IcculusC/harpua/tree/main/packages/agent-tools#readme",
  "bugs": {
    "url": "https://github.com/IcculusC/harpua/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@langchain/core": "^1",
    "unpdf": "^1",
    "zod": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "unpdf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@harpua/eslint-config": "workspace:*",
    "@harpua/typescript-config": "workspace:*",
    "@langchain/core": "1.2.1",
    "@swc/core": "1.16.2",
    "@types/node": "22.15.30",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "unpdf": "1.6.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2",
    "zod": "3.25.76"
  },
  "dependencies": {
    "ml-distance": "~4.0.1",
    "node-html-markdown": "^2.0.0"
  }
}
