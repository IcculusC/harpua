{
  "name": "harpua-weather-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A NestJS + LangGraph weather agent, scaffolded with create-harpua-app",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "chat": "nest build && node --env-file-if-exists=.env dist/cli.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "prepare": "harpua-skills"
  },
  "dependencies": {
    "@harpua/agent-tools": "^1.0.0-next.0",
    "@harpua/langgraph": "^1.0.0-next.1",
    "@harpua/models": "^1.0.0-next.1",
    "@langchain/core": "^1",
    "@langchain/langgraph": "^1",
    "@langchain/ollama": "^1",
    "@langchain/openai": "^1",
    "@langchain/openrouter": "^0.4.3",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@harpua/langgraph-testing": "^1.0.0-next.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.1",
    "@swc/core": "1.16.2",
    "@types/node": "22.15.30",
    "eslint": "9.39.4",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
